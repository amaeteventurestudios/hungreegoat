# Run python3 scripts/bootstrap.py to generate private local configuration.
# No credentials are included in this template.
STUDIO_ENV=development
COMPOSE_PROJECT_NAME=hg-studio-dev
STUDIO_LOG_LEVEL=INFO
STUDIO_UID=1000
STUDIO_GID=1000
STUDIO_BIND_HOST=127.0.0.1
STUDIO_WEB_PORT=3210
STUDIO_API_PORT=8310
STUDIO_PUBLIC_URL=http://localhost:3210
STUDIO_DB_PASSWORD=
STUDIO_ASSET_ROOT=
STUDIO_SECRET_DIRECTORY=
# For API execution outside Compose, supply a complete server-only URL:
# STUDIO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
