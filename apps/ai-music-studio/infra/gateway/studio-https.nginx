# Dedicated Studio vhost on the existing shared nginx gateway. No broadcast vhost changes.
server {
    listen 80;
    listen [::]:80;
    server_name studio.hungreegoat.com;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/hg-studio-acme;
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name studio.hungreegoat.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/studio.hungreegoat.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studio.hungreegoat.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 101m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://127.0.0.1:13211;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
